---
/**
 * The site's light/dark toggle: a toggle button (pressed = dark) that switches the
 * `data-theme` on `<html>` and remembers the pick (see `theme.ts`). It stays hidden without JavaScript,
 * where the page simply follows `prefers-color-scheme`. Pair it with `ThemeInit` in the `<head>`.
 */
---

<button class="site-toggle" type="button" aria-pressed="false" data-theme-toggle hidden>
	<span class="site-toggle__track" aria-hidden="true"><span class="site-toggle__thumb"></span></span>
	<span class="site-toggle__label">Dark mode</span>
</button>

<script>
	import type { ThemeStorage } from './theme';
	import { mountThemeToggle } from './toggle';

	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	if (button) {
		let storage: ThemeStorage | undefined;
		try {
			storage = window.localStorage;
		} catch {
			// Storage is blocked; the toggle still works for this page view.
		}
		mountThemeToggle(button, { storage, system: window.matchMedia('(prefers-color-scheme: dark)') });
	}
</script>
