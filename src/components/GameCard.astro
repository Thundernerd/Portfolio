---
/**
 * Card for one entry of the `games` collection: cover, title, role, studio, year (when known),
 * platforms, blurb, and links to the trailer and store pages. The title links to `href` (a site
 * path, e.g. a game page) when given, as `.game-card__title-link`. Each fact is a
 * `.game-card__fact` pairing a `.game-card__label` (`<dt>`) with its value. Each link is described
 * by the title, so "Trailer" stays meaningful out of context; the title's id is
 * `game-<entry id>-title`. A game that only reached soft launch (`softLaunchOnly`) gets a
 * "Soft launch · pulled" label (`.game-card__status`) after the title.
 *
 * Slots: `media` (wrapped in `.game-card__media`) replaces the cover when filled (e.g. with a
 * trailer embed); `extra` renders right after the blurb.
 *
 * Structural only. Layouts style it through the classes below or these custom properties:
 * `--card-gap`, `--card-tags-gap`.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveHref } from '../lib/url';
import GameFacts from './GameFacts.astro';

interface Props {
	game: CollectionEntry<'games'>;
	href?: string;
}

const { game, href } = Astro.props;
const { title, platforms, role, studio, year, cover, trailer, storeLinks, blurb, softLaunchOnly } = game.data;
const titleId = `game-${game.id}-title`;
// The cover fills its card: the full width on a phone, a column of the games grid (`--grid-min:
// 19rem` and `--grid-gap` in `global.css`) above that: two columns from 44rem, three from 66rem,
// each 21rem in the page's 67rem of content.
const coverSizes = '(min-width: 72rem) 21rem, (min-width: 66rem) 33vw, (min-width: 44rem) 50vw, 100vw';
const links = [...(trailer ? [{ label: 'Trailer', url: trailer }] : []), ...storeLinks];
// Filled `media` slot content replaces the cover. A slot that renders to nothing counts as unfilled, since
// `Astro.slots.has` is also true for `set:html={undefined}` (as `CollectionGrid` passes) or a false condition.
const hasMedia = Astro.slots.has('media') && (await Astro.slots.render('media')).trim() !== '';
---

<article class="game-card">
	{
		hasMedia ? (
			<div class="game-card__media">
				<slot name="media" />
			</div>
		) : (
			cover && <Image class="game-card__cover" src={cover} alt="" widths={[480, 960]} sizes={coverSizes} />
		)
	}
	<h3 class="game-card__title" id={titleId}>{href === undefined ? title : <a class="game-card__title-link" href={resolveHref(href)}>{title}</a>}</h3>
	{softLaunchOnly && <p class="game-card__status">Soft launch · pulled</p>}
	<dl class="game-card__meta">
		<GameFacts block="game-card" role={role} studio={studio} year={year} />
	</dl>
	<ul class="game-card__platforms">
		{platforms.map((platform) => <li class="game-card__platform">{platform}</li>)}
	</ul>
	<p class="game-card__blurb">{blurb}</p>
	<slot name="extra" />
	{
		links.length > 0 && (
			<ul class="game-card__links">
				{links.map((link) => (
					<li>
						<a class="game-card__link" href={link.url} aria-describedby={titleId}>{link.label}</a>
					</li>
				))}
			</ul>
		)
	}
</article>

<style>
	@layer components {
		.game-card {
			display: flex;
			flex-direction: column;
			gap: var(--card-gap, 0.75rem);
		}
		.game-card__cover {
			max-width: 100%;
			height: auto;
		}
		.game-card__meta,
		.game-card__platforms,
		.game-card__links {
			display: flex;
			flex-wrap: wrap;
			gap: var(--card-tags-gap, 0.5rem);
			list-style: none;
			margin: 0;
			padding: 0;
		}
	}
</style>
