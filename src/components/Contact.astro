---
/**
 * Contact section: an optional avatar, a heading, optional copy (default slot) and the contact links
 * (GitHub, LinkedIn, email, CV...) inside an `<address>`.
 *
 * Structural only. Layouts style it through the classes below or these custom properties:
 * `--contact-gap`, `--contact-links-gap`.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { resolveHref } from '../lib/url';
import type { ContactEntry } from './types';

interface Props {
	/**
	 * Site paths go through `withBase()`; absolute URLs (`https:`, `mailto:`) pass through. An entry
	 * without an `href` shows as plain text, `.contact__link--pending`.
	 */
	links: ContactEntry[];
	/** Anchor id of the section; the heading gets `${id}-heading`. */
	id?: string;
	title?: string;
	/** A portrait shown before the heading as `.contact__avatar`. */
	avatar?: ImageMetadata;
	/** The avatar's alt text; empty (decorative) by default. */
	avatarAlt?: string;
}

const { links, id = 'contact', title = 'Contact', avatar, avatarAlt = '' } = Astro.props;
const headingId = `${id}-heading`;
---

<section class="contact" id={id} aria-labelledby={headingId}>
	{avatar && <Image class="contact__avatar" src={avatar} alt={avatarAlt} />}
	<h2 class="contact__title" id={headingId}>{title}</h2>
	<slot />
	<address class="contact__address">
		<ul class="contact__links">
			{
				links.map((link) => (
					<li>
						{link.href === undefined ? (
							<span class="contact__link contact__link--pending">{link.label}</span>
						) : (
							<a class="contact__link" href={resolveHref(link.href)} download={link.download}>
								{link.label}
							</a>
						)}
					</li>
				))
			}
		</ul>
	</address>
</section>

<style>
	@layer components {
		.contact {
			display: grid;
			gap: var(--contact-gap, 1rem);
		}
		.contact__address {
			font-style: normal;
		}
		.contact__links {
			display: flex;
			flex-wrap: wrap;
			gap: var(--contact-links-gap, 1rem);
			list-style: none;
			margin: 0;
			padding: 0;
		}
	}
</style>
