---
/**
 * The home page content (`/`): the hero, then the released games, Zeepkist mods,
 * Unity plugins, tools (only when a tool project exists) and about/contact sections, built from the shared section components. Game cards link
 * to the game's page (`gamePath()`); project cards link to the project's page when it has one
 * (`projectPagePath()`) and get an inline stats line (language, stars) in their `extra` slot; games
 * without key art get a monogram tile in their `media` slot; `TODO` copy and contact links show as a
 * quiet placeholder. The about & contact section's avatar and links come from `profile` (`./profile`).
 * The sections' ids, headings and order come from `homeSections` (`./sections`), which the header nav
 * reads too; the content of each one is keyed by its id below.
 */
import type { CollectionEntry } from 'astro:content';
import { gamePath, projectPagePath } from '../../lib/paths';
import { plural } from '../../lib/text';
import CollectionGrid from '../CollectionGrid.astro';
import Contact from '../Contact.astro';
import Hero from '../Hero.astro';
import { monogramHtml } from './monogram';
import { presentableContactLink, presentableGame, presentableProject } from '../placeholders';
import { profile } from './profile';
import { anchor, type HomeSectionId, homeSections, isShown } from './sections';
import { languageBreakdown, repoStatsHtml, totalStars } from './stats';

type Game = CollectionEntry<'games'>;
type Project = CollectionEntry<'projects'>;

interface Props {
	games: Game[];
	projects: Project[];
}

const games = Astro.props.games.map(presentableGame);
const projects = Astro.props.projects.map(presentableProject);

const gameMedia = (entry: Game | Project) => (entry.collection === 'games' ? monogramHtml(entry) : undefined);
const projectStats = (entry: Game | Project) => (entry.collection === 'projects' ? repoStatsHtml(entry) : undefined);
const projectPage = (entry: Game | Project) => (entry.collection === 'projects' ? projectPagePath(entry) : undefined);
const ofKind = (kind: Project['data']['kind']) => projects.filter((project) => project.data.kind === kind);

interface GridContent {
	items: Game[] | Project[];
	itemHref?: (entry: Game | Project) => string | undefined;
	itemMedia?: (entry: Game | Project) => string | undefined;
	itemExtra?: (entry: Game | Project) => string | undefined;
	intro: string;
}

// The content of every section but `contact`, which is the `Contact` component below.
const grids: Record<Exclude<HomeSectionId, 'contact'>, GridContent> = {
	games: {
		items: games,
		itemHref: (entry) => gamePath(entry.id),
		itemMedia: gameMedia,
		intro: 'Commercial games I worked on, from co-founding a studio to building multiplayer systems.',
	},
	'zeepkist-mods': {
		items: ofKind('zeepkist-mod'),
		itemHref: projectPage,
		itemExtra: projectStats,
		intro: 'BepInEx mods for the soapbox racer Zeepkist, most of them built on ZeepSDK.',
	},
	'unity-plugins': {
		items: ofKind('unity-plugin'),
		itemHref: projectPage,
		itemExtra: projectStats,
		intro: 'Open-source editor and runtime tools for Unity, sorted by GitHub stars.',
	},
	tools: {
		items: ofKind('tool'),
		itemHref: projectPage,
		itemExtra: projectStats,
		intro: 'Standalone tools and utilities, outside Unity and Zeepkist.',
	},
};

// The sections on this page: the Tools section only appears once a tool project exists.
const sections = homeSections.filter((section) => isShown(section, projects));
const languages = languageBreakdown(projects);
const facts = [
	// A game pulled after its soft launch is on the page but was never released.
	plural(games.filter((game) => !game.data.softLaunchOnly).length, 'released game', 'released games'),
	plural(projects.length, 'open-source project', 'open-source projects'),
	plural(totalStars(projects), 'GitHub star', 'GitHub stars'),
];
---

<Hero
	title="Christiaan"
	tagline="Game developer & programmer."
	actions={[
		{ label: 'Released games', href: anchor('games') },
		{ label: 'Open source', href: anchor('zeepkist-mods') },
		{ label: 'Get in touch', href: anchor('contact') },
	]}
>
	<p class="site-hero__intro">
		I ship games on console and mobile, and build the tools around them: Unity plugins, a modding SDK and a
		records backend for the Zeepkist community.
	</p>
	<ul class="site-facts">
		{facts.map((fact) => <li>{fact}</li>)}
	</ul>
	{
		languages.length > 0 && (
			<figure slot="media" class="site-langs">
				<figcaption class="site-langs__caption">Projects by language</figcaption>
				<ul class="site-langs__list">
					{languages.map(({ language, colour, count, share }) => (
						<li class="site-langs__row" style={`--share: ${share}; --lang-colour: ${colour}`}>
							<span class="site-langs__name">{language}</span>
							<span class="site-langs__bar" aria-hidden="true" />
							<data class="site-langs__count" value={count}>{count}</data>
						</li>
					))}
				</ul>
			</figure>
		)
	}
</Hero>

{
	sections.map((section) => {
		if (section.id === 'contact') {
			return (
				<Contact
					id={section.id}
					title={section.title}
					avatar={profile.avatar}
					avatarAlt={profile.avatarAlt}
					links={profile.links.map(presentableContactLink)}
				>
					<p class="site-about">
						I'm Christiaan, a game developer and programmer. Besides shipping games I build the parts players
						rarely see: editor tooling, multiplayer systems, backends and the SDKs other modders build on.
					</p>
				</Contact>
			);
		}
		const { intro, ...grid } = grids[section.id];
		return (
			<CollectionGrid id={section.id} title={section.title} {...grid}>
				<p>{intro}</p>
			</CollectionGrid>
		);
	})
}
