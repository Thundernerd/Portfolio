---
/**
 * The home page content (`/`): the hero, then the released games,
 * featured projects, Zeepkist mods, Unity plugins and about/contact sections, built from the shared
 * section components. Project cards get an inline stats line (language, stars) in their `extra`
 * slot; games without key art get a monogram tile in their `media` slot; `TODO` copy shows as a
 * quiet placeholder. The sections' ids, headings and order come from `homeSections` (`./sections`),
 * which the header nav reads too; the content of each one is keyed by its id below.
 */
import type { CollectionEntry } from 'astro:content';
import CollectionGrid from '../CollectionGrid.astro';
import Contact from '../Contact.astro';
import Hero from '../Hero.astro';
import { monogramHtml } from './monogram';
import { presentableGame, presentableProject } from './placeholders';
import { anchor, type HomeSectionId, homeSections } from './sections';
import { languageBreakdown, repoStatsHtml, totalStars } from './stats';
import { plural } from './text';

type Game = CollectionEntry<'games'>;
type Project = CollectionEntry<'projects'>;

interface Props {
	games: Game[];
	projects: Project[];
}

const games = Astro.props.games.map(presentableGame);
const projects = Astro.props.projects.map(presentableProject);

const gameMedia = (entry: Game | Project) => (entry.collection === 'games' ? monogramHtml(entry) : undefined);
const projectStats = (entry: Game | Project) => (entry.collection === 'projects' ? repoStatsHtml(entry) : undefined);
const ofKind = (kind: Project['data']['kind']) => projects.filter((project) => project.data.kind === kind);

interface GridContent {
	items: Game[] | Project[];
	itemMedia?: (entry: Game | Project) => string | undefined;
	itemExtra?: (entry: Game | Project) => string | undefined;
	intro: string;
}

// The content of every section but `contact`, which is the `Contact` component below.
const grids: Record<Exclude<HomeSectionId, 'contact'>, GridContent> = {
	games: {
		items: games,
		itemMedia: gameMedia,
		intro: 'Commercial games I worked on, from co-founding a studio to building multiplayer systems.',
	},
	featured: {
		items: ofKind('featured'),
		itemExtra: projectStats,
		intro: 'Bigger personal projects, mostly around the Zeepkist modding scene.',
	},
	'zeepkist-mods': {
		items: ofKind('zeepkist-mod'),
		itemExtra: projectStats,
		intro: 'BepInEx mods for the soapbox racer Zeepkist, most of them built on ZeepSDK.',
	},
	'unity-plugins': {
		items: ofKind('unity-plugin'),
		itemExtra: projectStats,
		intro: 'Open-source editor and runtime tools for Unity, sorted by GitHub stars.',
	},
};

// `tool` projects have no section in the agreed order, so they are left out of the page and the facts.
const shown = projects.filter((project) => project.data.kind !== 'tool');
const languages = languageBreakdown(shown);
const facts = [
	plural(games.length, 'released game', 'released games'),
	plural(shown.length, 'open-source project', 'open-source projects'),
	plural(totalStars(shown), 'GitHub star', 'GitHub stars'),
];
---

<Hero
	title="Christiaan"
	tagline="Game developer & programmer."
	actions={[
		{ label: 'Released games', href: anchor('games') },
		{ label: 'Open source', href: anchor('featured') },
		{ label: 'Get in touch', href: anchor('contact') },
	]}
>
	<p class="site-hero__intro">
		I ship games on console and mobile, and build the tools around them: Unity plugins, a modding SDK and a
		records backend for the Zeepkist community.
	</p>
	<ul class="site-facts">
		{facts.map((fact) => <li>{fact}</li>)}
	</ul>
	{
		languages.length > 0 && (
			<figure slot="media" class="site-langs">
				<figcaption class="site-langs__caption">Projects by language</figcaption>
				<ul class="site-langs__list">
					{languages.map(({ language, colour, count, share }) => (
						<li class="site-langs__row" style={`--share: ${share}; --lang-colour: ${colour}`}>
							<span class="site-langs__name">{language}</span>
							<span class="site-langs__bar" aria-hidden="true" />
							<data class="site-langs__count" value={count}>{count}</data>
						</li>
					))}
				</ul>
			</figure>
		)
	}
</Hero>

{
	homeSections.map((section) => {
		if (section.id === 'contact') {
			return (
				<Contact
					id={section.id}
					title={section.title}
					links={[
						{ label: 'GitHub · Thundernerd', href: 'https://github.com/Thundernerd' },
						{ label: 'GitHub · donderjoekel', href: 'https://github.com/donderjoekel' },
					]}
				>
					<p class="site-about">
						I'm Christiaan, a game developer and programmer. Besides shipping games I build the parts players
						rarely see: editor tooling, multiplayer systems, backends and the SDKs other modders build on.
					</p>
				</Contact>
			);
		}
		const { intro, ...grid } = grids[section.id];
		return (
			<CollectionGrid id={section.id} title={section.title} {...grid}>
				<p>{intro}</p>
			</CollectionGrid>
		);
	})
}
