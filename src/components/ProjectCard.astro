---
/**
 * Card for one entry of the `projects` collection: image, title, blurb, tags, star count and a link
 * to the GitHub repo. The star count comes from `repoStats()`: GitHub's count when the prebuild
 * fetcher reached it, the entry's `stars` otherwise. The title links to `href` (a site path, e.g. a
 * project page) when given, as `.project-card__title-link`.
 * An archived repo gets an "Archived" label (`.project-card__archived`) after the title; like the
 * star count, the flag comes from `repoStats()`: GitHub's when fetched, the entry's `archived` otherwise.
 *
 * Slots: `media` (wrapped in `.project-card__media`) replaces the image when filled; `extra`
 * renders right after the blurb (e.g. more repo stats).
 *
 * Structural only. Layouts style it through the classes below or these custom properties:
 * `--card-gap`, `--card-tags-gap`.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { repoStats, repoUrl } from '../lib/github-stats';
import { resolveHref } from '../lib/url';

interface Props {
	project: CollectionEntry<'projects'>;
	href?: string;
}

const { project, href } = Astro.props;
const { title, blurb, repo, tags, image } = project.data;
const { stars, archived } = repoStats(project.data);
const starCount = stars?.toLocaleString('en-US');
// Filled `media` slot content replaces the image. A slot that renders to nothing counts as unfilled, since
// `Astro.slots.has` is also true for `set:html={undefined}` (as `CollectionGrid` passes) or a false condition.
const hasMedia = Astro.slots.has('media') && (await Astro.slots.render('media')).trim() !== '';
---

<article class="project-card" data-kind={project.data.kind}>
	{
		hasMedia ? (
			<div class="project-card__media">
				<slot name="media" />
			</div>
		) : (
			image && <Image class="project-card__image" src={image} alt="" />
		)
	}
	<h3 class="project-card__title">{href === undefined ? title : <a class="project-card__title-link" href={resolveHref(href)}>{title}</a>}</h3>
	{archived && <p class="project-card__archived">Archived</p>}
	<p class="project-card__blurb">{blurb}</p>
	<slot name="extra" />
	{
		tags.length > 0 && (
			<ul class="project-card__tags">
				{tags.map((tag) => (
					<li class="project-card__tag">{tag}</li>
				))}
			</ul>
		)
	}
	<p class="project-card__meta">
		<a class="project-card__repo" href={repoUrl(repo)}>{repo}</a>
		{
			stars !== undefined && (
				<span class="project-card__stars">
					<data class="project-card__star-count" value={stars}>{starCount}</data>
					<span class="project-card__star-label">{stars === 1 ? 'star' : 'stars'}</span>
				</span>
			)
		}
	</p>
</article>

<style>
	@layer components {
		.project-card {
			display: flex;
			flex-direction: column;
			gap: var(--card-gap, 0.75rem);
		}
		.project-card__image {
			max-width: 100%;
			height: auto;
		}
		.project-card__tags {
			display: flex;
			flex-wrap: wrap;
			gap: var(--card-tags-gap, 0.5rem);
			list-style: none;
			margin: 0;
			padding: 0;
		}
	}
</style>
