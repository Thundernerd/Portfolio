---
/**
 * The `/proto/dark` home: the shared section components in the agreed order (Hero, Released games,
 * Featured projects, Zeepkist mods, Unity plugins, About/Contact), fed the given collection entries.
 * Games and featured projects get large media (a click-to-play trailer poster or a generated tile);
 * the mod and plugin collections stay compact.
 */
import type { CollectionEntry } from 'astro:content';
import CollectionGrid from '../../CollectionGrid.astro';
import Contact from '../../Contact.astro';
import Hero from '../../Hero.astro';
import { repoStats } from '../../../lib/github-stats';
import { withoutTodos } from './content';
import { cardMedia } from './media';

interface Props {
	games: CollectionEntry<'games'>[];
	projects: CollectionEntry<'projects'>[];
}

const games = Astro.props.games.map(withoutTodos);
const projects = Astro.props.projects.map(withoutTodos);
const ofKind = (kind: CollectionEntry<'projects'>['data']['kind']) => projects.filter((project) => project.data.kind === kind);
const featured = ofKind('featured');
const mods = ofKind('zeepkist-mod');
const plugins = ofKind('unity-plugin');
const stars = projects.reduce((sum, project) => sum + (repoStats(project.data).stars ?? 0), 0);

const stats = [
	{ label: 'Released games', value: games.length },
	{ label: 'Zeepkist mods', value: mods.length },
	{ label: 'Unity plugins', value: plugins.length },
	{ label: 'GitHub stars', value: stars },
];
const links = [
	{ label: 'GitHub · Thundernerd', href: 'https://github.com/Thundernerd' },
	{ label: 'GitHub · donderjoekel', href: 'https://github.com/donderjoekel' },
];
---

<Hero
	title="Christiaan"
	tagline="Game developer & programmer"
	actions={[
		{ label: 'See the games', href: '#games' },
		{ label: 'Open-source work', href: '#featured' },
	]}
>
	<p class="dark-hero__intro">
		I build games and the tools behind them: shipped titles on Xbox, Switch and mobile, a records platform for
		Zeepkist, and open-source Unity plugins.
	</p>
	<dl class="dark-hero__stats">
		{
			stats.map((stat) => (
				<div class="dark-hero__stat">
					<dt>{stat.label}</dt>
					<dd>{stat.value.toLocaleString('en-US')}</dd>
				</div>
			))
		}
	</dl>
	<div class="dark-hero__art" slot="media" aria-hidden="true">
		<div class="dark-hero__sun"></div>
		<div class="dark-hero__floor"></div>
	</div>
</Hero>

<CollectionGrid id="games" title="Released games" items={games} itemMedia={cardMedia}>
	<p>Commercial titles I helped ship, from co-founding a studio to building multiplayer systems.</p>
</CollectionGrid>
<CollectionGrid id="featured" title="Featured projects" items={featured} itemMedia={cardMedia}>
	<p>Larger systems and tools, most of them around the Zeepkist modding scene.</p>
</CollectionGrid>
<CollectionGrid id="zeepkist-mods" title="Zeepkist mods" items={mods}>
	<p>Mods for the soapbox racer Zeepkist, built on ZeepSDK.</p>
</CollectionGrid>
<CollectionGrid id="unity-plugins" title="Unity plugins" items={plugins}>
	<p>Open-source editor and runtime extensions for Unity, ordered by GitHub stars.</p>
</CollectionGrid>
<Contact id="contact" title="About & contact" links={links}>
	<p class="dark-contact__copy">
		I’m Christiaan, a programmer who has spent my career on games: co-founding a studio, shipping on consoles and
		mobile, and building the tooling and backends around them. My work lives on GitHub; say hi there.
	</p>
</Contact>

<script>
	import { playTrailer } from './trailer';

	// Swap a trailer poster for the YouTube player only when it is clicked, so the player and its scripts
	// load on demand (a poster without a cover is a lazy-loaded YouTube thumbnail image).
	document.addEventListener('click', (event) => {
		const poster = (event.target as Element | null)?.closest<HTMLButtonElement>('button.dark-trailer[data-youtube-id]');
		if (poster) playTrailer(poster);
	});
</script>
