---
import { getCollection } from 'astro:content';
import Home from '../components/home/Home.astro';
import Base from '../layouts/Base.astro';

const games = await getCollection('games');
const projects = await getCollection('projects');
---

<Base
	title="Christiaan · Game developer & programmer"
	description="Christiaan's portfolio: released games, open-source Unity plugins and Zeepkist mods."
>
	<Home games={games} projects={projects} />
</Base>
