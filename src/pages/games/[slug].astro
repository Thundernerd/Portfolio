---
/**
 * A page per released game at `gamePath()` (`/games/<entry id>/`), built from its
 * `src/content/games/` entry.
 */
import type { GetStaticPaths } from 'astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import GamePage from '../../components/game/GamePage.astro';
import { isTodo } from '../../components/placeholders';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
	const games = await getCollection('games');
	return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}) satisfies GetStaticPaths;

interface Props {
	game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { Content } = await render(game);
const { title, blurb } = game.data;
const description = isTodo(blurb) ? `Christiaan's work on ${title}.` : `Christiaan's work on ${title}: ${blurb}`;
---

<Base title={`${title} · Christiaan`} description={description}>
	<GamePage game={game}>
		<Content />
	</GamePage>
</Base>
