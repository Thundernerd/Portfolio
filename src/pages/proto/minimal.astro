---
/**
 * Prototype B, "minimal developer": the home page sections in the minimal style, for comparing
 * with the other prototypes before the style is picked (#12).
 */
import { getCollection } from 'astro:content';
import MinimalHome from '../../components/proto/minimal/MinimalHome.astro';
import Minimal from '../../layouts/proto/Minimal.astro';

const games = await getCollection('games');
const projects = await getCollection('projects');
---

<Minimal title="Christiaan · Game developer & programmer" description="Prototype B: a minimal, typography-first portfolio style.">
	<MinimalHome games={games} projects={projects} />
</Minimal>
