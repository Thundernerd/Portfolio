---
/**
 * The site's layout, in the minimal style chosen in #12: typography first, monospace accents,
 * little imagery and a light/dark toggle that follows `prefers-color-scheme` by default. Owns the
 * document, the header with the section navigation, and the footer; pages fill the `<main>`.
 */
import { anchor, homeSections } from '../components/home/sections';
import ThemeInit from '../components/theme/ThemeInit.astro';
import ThemeToggle from '../components/theme/ThemeToggle.astro';
import { absoluteUrl, withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
// The home page's sections, linked through the site root so the nav works from any page.
// Search engines and link previews need absolute URLs: the page's own and the shared preview image.
const canonical = new URL(Astro.url.pathname, import.meta.env.SITE).href;
const ogImage = { url: absoluteUrl('og.png'), width: 1200, height: 630, alt: '~/christiaan: game developer and programmer' };
const nav = homeSections.map((section) => ({ label: section.navLabel, href: withBase(anchor(section.id)) }));
---

<html lang="en" class="site">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="christiaan" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage.url} />
		<meta property="og:image:width" content={String(ogImage.width)} />
		<meta property="og:image:height" content={String(ogImage.height)} />
		<meta property="og:image:alt" content={ogImage.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
		<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ThemeInit />
	</head>
	<body>
		<a class="site-skip" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-brand" href={withBase('')}>
					<span class="site-brand__prompt" aria-hidden="true">~/</span>christiaan
				</a>
				<nav class="site-nav" aria-label="Sections">
					<ul>
						{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
					</ul>
				</nav>
				<ThemeToggle />
			</div>
		</header>
		<main id="main" class="site-main">
			<slot />
		</main>
		<footer class="site-footer">
			<p>Built with Astro · <a href="https://github.com/Thundernerd/Portfolio">source</a></p>
		</footer>
	</body>
</html>
