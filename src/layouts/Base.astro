---
/**
 * The site's layout, in the minimal style chosen in #12: typography first, monospace accents,
 * little imagery and a light/dark toggle that follows `prefers-color-scheme` by default. Owns the
 * document, the header with the section navigation, and the footer; pages fill the `<main>`.
 */
import { anchor, homeSections } from '../components/home/sections';
import ThemeInit from '../components/theme/ThemeInit.astro';
import ThemeToggle from '../components/theme/ThemeToggle.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
// The home page's sections, linked through the site root so the nav works from any page.
const nav = homeSections.map((section) => ({ label: section.navLabel, href: withBase(anchor(section.id)) }));
---

<html lang="en" class="mn">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ThemeInit />
	</head>
	<body>
		<a class="mn-skip" href="#main">Skip to content</a>
		<header class="mn-header">
			<div class="mn-header__inner">
				<a class="mn-brand" href={withBase('')}>
					<span class="mn-brand__prompt" aria-hidden="true">~/</span>christiaan
				</a>
				<nav class="mn-nav" aria-label="Sections">
					<ul>
						{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
					</ul>
				</nav>
				<ThemeToggle />
			</div>
		</header>
		<main id="main" class="mn-main">
			<slot />
		</main>
		<footer class="mn-footer">
			<p>Built with Astro · <a href="https://github.com/Thundernerd/Portfolio">source</a></p>
		</footer>
	</body>
</html>
