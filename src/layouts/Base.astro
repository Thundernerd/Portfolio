---
/**
 * The site's layout, in the minimal style chosen in #12: typography first, monospace accents,
 * little imagery and a light/dark toggle that follows `prefers-color-scheme` by default. Owns the
 * document, the header with the section navigation, and the footer; pages fill the `<main>`.
 */
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { anchor, homeSections, isShown } from '../components/home/sections';
import ThemeInit from '../components/theme/ThemeInit.astro';
import ThemeToggle from '../components/theme/ThemeToggle.astro';
import { absoluteUrl, resolveHref, withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/**
	 * The page's link-preview image and its alt text, in place of the site card (`public/og.png`):
	 * an `astro:assets` image (its size is declared too), a site path such as `'talks/cover.jpg'` or
	 * an absolute URL.
	 */
	image?: { src: ImageMetadata | string; alt: string };
}

const { title, description, image } = Astro.props;
// Search engines and link previews need absolute URLs: the page's own and the shared preview image.
// `Astro.url.pathname` already starts with the base path, so it is resolved against `site` directly.
const canonical = new URL(Astro.url.pathname, import.meta.env.SITE).href;
const ogImage = previewImage(image);

/** The absolute URL, media type and size (when known) and alt text of the page's link-preview image. */
function previewImage(image: Props['image']): { url: string; type?: string; width?: number; height?: number; alt: string } {
	if (!image) return { url: absoluteUrl('og.png'), type: 'image/png', width: 1200, height: 630, alt: '~/christiaan: game developer and programmer' };
	const { src, alt } = image;
	if (typeof src === 'string') return { url: new URL(resolveHref(src), import.meta.env.SITE).href, alt };
	// An `astro:assets` image's `src` is already under the base path, so it is resolved against `site`.
	return { url: new URL(src.src, import.meta.env.SITE).href, type: mediaType(src.format), width: src.width, height: src.height, alt };
}

/** The media type of an `astro:assets` image format, such as `image/jpeg` for `jpg`. */
function mediaType(format: ImageMetadata['format']): string {
	return `image/${{ jpg: 'jpeg', svg: 'svg+xml' }[format as string] ?? format}`;
}
// The home page's sections, linked through the site root so the nav works from any page. Reads the
// projects itself so every page's nav lists the same sections as the home page (see `isShown()`).
const projects = await getCollection('projects');
const nav = homeSections.filter((section) => isShown(section, projects)).map((section) => ({ label: section.navLabel, href: withBase(anchor(section.id)) }));
---

<html lang="en" class="site">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="christiaan" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage.url} />
		{ogImage.type && <meta property="og:image:type" content={ogImage.type} />}
		{ogImage.width !== undefined && <meta property="og:image:width" content={String(ogImage.width)} />}
		{ogImage.height !== undefined && <meta property="og:image:height" content={String(ogImage.height)} />}
		<meta property="og:image:alt" content={ogImage.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<!-- `sizes` on the .ico (which holds 16, 32 and 48px) makes browsers that support SVG pick the SVG. -->
		<link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
		<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
		<link rel="sitemap" href={withBase('sitemap-index.xml')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ThemeInit />
	</head>
	<body>
		<a class="site-skip" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-brand" href={withBase('')}>
					<span class="site-brand__prompt" aria-hidden="true">~/</span>christiaan
				</a>
				<nav class="site-nav" aria-label="Sections">
					<ul>
						{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
					</ul>
				</nav>
				<ThemeToggle />
			</div>
		</header>
		<main id="main" class="site-main">
			<slot />
		</main>
		<footer class="site-footer">
			<p>Built with Astro · <a href="https://github.com/Thundernerd/Portfolio">source</a></p>
		</footer>
	</body>
</html>
